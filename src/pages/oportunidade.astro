---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { LINK_AFILIADO } from '../data/site.js';
import { perguntasDe, schemaFaq } from '../data/perguntas.js';

// Os treze PINs oficiais de graduação, na ordem da escada. Os nomes vêm dos
// próprios medalhões, que são material da empresa — por isso os nomes entram
// como verificados.
//
// As EXIGÊNCIAS de cada nível não entram. Elas circulam em site de
// distribuidor e em PDF de grupo, e não localizei o documento oficial que as
// fixe. A única exigência publicada aqui é a do meu próximo nível, porque essa
// eu leio no meu próprio painel.
import consultor from '../assets/pins/consultor.png';
import empreendedor from '../assets/pins/empreendedor.png';
import especialista from '../assets/pins/especialista.png';
import supervisor from '../assets/pins/supervisor.png';
import gestor from '../assets/pins/gestor.png';
import executivo from '../assets/pins/executivo.png';
import diretor from '../assets/pins/diretor.png';
import diretorSenior from '../assets/pins/diretor-senior.png';
import acionista from '../assets/pins/acionista.png';
import embaixador from '../assets/pins/embaixador.png';
import embaixadorSenior from '../assets/pins/embaixador-senior.png';
import vicePresidente from '../assets/pins/vice-presidente.png';
import presidente from '../assets/pins/presidente.png';

const NIVEIS = [
  { n: 1, nome: 'Consultor', img: consultor },
  { n: 2, nome: 'Empreendedor', img: empreendedor },
  { n: 3, nome: 'Especialista', img: especialista },
  { n: 4, nome: 'Supervisor', img: supervisor },
  { n: 5, nome: 'Gestor', img: gestor },
  { n: 6, nome: 'Executivo', img: executivo },
  { n: 7, nome: 'Diretor', img: diretor },
  { n: 8, nome: 'Diretor Sênior', img: diretorSenior },
  { n: 9, nome: 'Acionista', img: acionista },
  { n: 10, nome: 'Embaixador', img: embaixador },
  { n: 11, nome: 'Embaixador Sênior', img: embaixadorSenior },
  { n: 12, nome: 'Vice-Presidente', img: vicePresidente },
  { n: 13, nome: 'Presidente', img: presidente },
];

// Onde eu estou de verdade, lido no meu painel em 21/10/2026.
const MEU_NIVEL = 1;

// As quatro perguntas de dinheiro vivem em src/data/perguntas.js, com as das
// outras páginas, e aparecem aqui e na análise da empresa — são as mesmas
// perguntas nos dois lugares, e escrever duas vezes é escrever duas respostas.
const faq = perguntasDe('/oportunidade');

const atualizadoEm = '2026-10-20';
const title = 'Programa de afiliados MOVVA: como funciona e quanto eu realmente ganhei';
const description =
  'Como funciona a remuneração de afiliados da MOVVA Brasil, quanto custa participar e os números reais de um afiliado VIP em três meses e meio. Sem projeção de matriz cheia.';
---

<Base {title} {description} path="/oportunidade" {atualizadoEm} schemaExtra={schemaFaq(faq)}>
  <article class="wrap stack--lg stack">

    <header class="stack">
      <p class="eyebrow">Programa de afiliados</p>
      <h1>Como funciona o programa de afiliados da MOVVA</h1>
      <p class="answer">
        A MOVVA remunera afiliados por indicação de planos, por posição em uma matriz
        e por bônus sobre a equipe direta. Existe uma licença paga que dobra os
        ganhos. Não há ganho garantido, e a maior parte da minha comissão até hoje
        veio de pessoas entrando, não de contas de celular sendo pagas.
      </p>
    </header>

    <section class="stack">
      <div class="card card--warn">
        <h3>Leia isto antes de qualquer coisa</h3>
        <p>
          Programas de marketing de rede têm uma distribuição de resultados muito
          desigual. O material de treinamento da própria MOVVA apresenta esta
          proporção: de <strong>200 pessoas convidadas</strong>, cerca de 100 conhecem
          o negócio, 10 entram, 6 ficam, 3 continuam e <strong>1 se destaca</strong>.
          Isso é 0,5%.
        </p>
        <p>
          Qualquer número de ganho que você vir por aí precisa ser lido junto com essa
          proporção. Projeções construídas sobre uma matriz completa de 11.110 pessoas
          não são previsão de resultado: são o cenário máximo teórico.
        </p>
      </div>
    </section>

    <section class="stack">
      <h2>Como a remuneração é composta</h2>
      <ul>
        <li><strong>Bônus de adesão</strong> — percentual sobre a entrada de quem você indica.</li>
        <li><strong>Bônus de recorrência</strong> — percentual sobre a mensalidade, enquanto a pessoa continua pagando.</li>
        <li><strong>Bônus de matriz</strong> — percentual sobre movimentação nos níveis da sua matriz.</li>
        <li><strong>Matching</strong> — percentual sobre o que seus diretos ganham.</li>
        <li><strong>Licença VIP</strong> — licença paga que dobra os ganhos e a pontuação do plano de carreira.</li>
        <li><strong>GoldPoints</strong> — pontuação que destrava graduações e premiações.</li>
      </ul>
      <p class="meta-line">
        Os percentuais e os valores mudam. Confirme sempre no material oficial e
        vigente da empresa, não em PDF antigo circulando em grupo de WhatsApp.
      </p>
    </section>

    <section class="stack">
      <h2>A escada tem treze degraus</h2>
      <p>
        O plano de carreira da MOVVA vai de Consultor a Presidente. Estes são os
        medalhões oficiais de cada graduação, na ordem.
      </p>

      <ol class="escada" role="list">
        {NIVEIS.map((nv) => (
          <li class={`degrau${nv.n === MEU_NIVEL ? ' degrau--meu' : ''}`}>
            <Image src={nv.img} alt={`Medalhão de ${nv.nome}`} width={88} densities={[1, 2]} />
            <span class="degrau__n">{nv.n}</span>
            <span class="degrau__nome">{nv.nome}</span>
            {nv.n === MEU_NIVEL && <span class="degrau__aqui">eu estou aqui</span>}
          </li>
        ))}
      </ol>

      <p>
        Eu estou no primeiro. Cadastrei-me em julho de 2026 e graduei Consultor em
        agosto; de lá para cá não subi. Para o segundo degrau, o meu painel pede
        seis diretos ativos e eu tenho quatro.
      </p>
      <p class="meta-line">
        Os nomes das graduações vêm dos medalhões oficiais da empresa. As
        exigências de cada nível não estão aqui porque eu não localizei o
        documento oficial que as fixe — o que circula em site de distribuidor e
        em PDF de grupo eu não reproduzo. A única exigência publicada acima é a
        do meu próximo nível, porque essa eu leio no meu próprio painel.
      </p>
    </section>

    <section class="stack">
      <h2>Os meus números, abertos</h2>
      <p>
        Afiliado VIP, cadastrado em julho de 2026, graduação Consultor, oito pessoas
        na rede. Período de 7 de julho a 20 de outubro de 2026.
      </p>
      <div class="table-scroll">
        <table>
          <thead><tr><th>Indicador</th><th class="num">Valor</th></tr></thead>
          <tbody>
            <tr><td>Comissão gerada no período</td><td class="num">R$ 146,08</td></tr>
            <tr><td>Recebido líquido, após taxa de saque de 16%</td><td class="num">R$ 115,43</td></tr>
            <tr><td>Parcela originada de entrada e licença</td><td class="num">96,7%</td></tr>
            <tr><td>Bônus de recorrência sobre plano de telefonia</td><td class="num">R$ 0,00</td></tr>
            <tr><td>Comissão em outubro de 2026</td><td class="num">R$ 0,00</td></tr>
            <tr><td>Custo mensal do meu plano</td><td class="num">R$ 159,80</td></tr>
            <tr><td>Resultado acumulado até aqui</td><td class="num">negativo</td></tr>
          </tbody>
        </table>
      </div>
      <p>
        Publico isso porque considero desonesto recrutar alguém mostrando apenas o
        cenário bom. Se em algum momento esses números virarem, eu atualizo a tabela.
      </p>
    </section>

    <section class="stack">
      <h2>As perguntas que me fazem sobre dinheiro</h2>
      <div class="stack">
        {faq.map((i) => (
          <details class="qa">
            <summary>{i.p}</summary>
            <p>{i.r}</p>
          </details>
        ))}
      </div>
      <p class="meta-line">
        As outras perguntas sobre a empresa e sobre o plano estão na
        {' '}<a href="/perguntas-frequentes">central de perguntas</a>.
      </p>
    </section>

    <section class="stack">
      <h2>Para quem isso faz sentido</h2>
      <p>
        Na minha leitura, faz sentido para quem <strong>já quer trocar de operadora</strong>
        e, usando o serviço, decide indicar. O ganho vira consequência de um produto que
        a pessoa usaria de qualquer jeito.
      </p>
      <p>
        Não faz sentido para quem precisa de dinheiro rápido, nem para quem vai entrar
        com recurso que faz falta no orçamento. A proporção de 0,5% lá em cima não é
        detalhe: é a informação mais importante desta página.
      </p>
      <div class="card card--accent">
        <h3>Se ainda quiser conhecer</h3>
        <p>
          O cadastro é feito na plataforma oficial da MOVVA. Se você usar o link
          abaixo, eu recebo comissão caso você se torne cliente ou afiliado — é assim
          que este site se paga, e é por isso que ele mostra os números ruins também.
        </p>
        <p>
          <a class="btn" href={LINK_AFILIADO} rel="nofollow sponsored noopener" target="_blank">
            Ver a apresentação oficial
          </a>
        </p>
      </div>
    </section>

  </article>
</Base>

<style>
  /* Treze medalhões numa escada. Doze apagados e um aceso: o contraste é o
     argumento da seção, e é mais honesto do que qualquer frase. Mostrar os
     treze brilhando seria pôster de recrutamento. */
  .escada {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(5.4rem, 1fr));
    gap: 1.1rem 0.6rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .degrau {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.18rem;
    text-align: center;
    min-width: 0;
  }
  .degrau img {
    width: 100%;
    max-width: 72px;
    height: auto;
    display: block;
    /* Os que ainda não foram alcançados ficam apagados: não é enfeite, é o
       estado real deles para quem está lendo. */
    filter: grayscale(1) brightness(0.62);
    opacity: 0.5;
    transition: filter 0.2s ease, opacity 0.2s ease;
  }
  .degrau:hover img { opacity: 0.8; }
  .degrau__n {
    font-family: var(--mono);
    font-size: 0.64rem;
    color: var(--muted);
  }
  .degrau__nome {
    font-size: 0.74rem;
    line-height: 1.25;
    color: var(--muted);
  }

  .degrau--meu img {
    filter: none;
    opacity: 1;
  }
  .degrau--meu .degrau__nome { color: var(--ink); font-weight: 600; }
  .degrau--meu .degrau__n { color: var(--accent); }
  .qa {
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: var(--surface);
    padding: 0.8rem 1rem;
  }
  .qa summary { cursor: pointer; font-weight: 600; }
  .qa[open] summary { color: var(--accent); margin-bottom: 0.5rem; }
  .qa p { margin: 0; color: var(--muted); font-size: 0.94rem; }

  /* --accent-ink: a pílula é verde sobre véu verde, e --accent não alcança os
     4,5:1 nesse par. Mesmo motivo da etiqueta da tabela de planos. */
  .degrau__aqui {
    font-family: var(--mono);
    font-size: 0.6rem;
    color: var(--accent-ink);
    border: 1px solid var(--borda-verde);
    background: var(--veu-2);
    border-radius: 999px;
    padding: 0.1rem 0.4rem;
    margin-top: 0.15rem;
  }
</style>
