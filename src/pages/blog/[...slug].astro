---
import Base from '../../layouts/Base.astro';
import ProximoPasso from '../../components/ProximoPasso.astro';
import NotaDeTransparencia from '../../components/NotaDeTransparencia.astro';
import { getCollection, render } from 'astro:content';
import { SITE, AUTOR } from '../../data/site.js';
import { ROTULO_DO_CLUSTER } from '../../data/clusters.js';

// A mensagem que ja vai escrita no WhatsApp muda conforme o assunto do post,
// para voce saber de onde a pessoa veio sem precisar perguntar.
const CONTEXTO_POR_CLUSTER = {
  categoria: 'cobertura',
  diferencial: 'plano',
  dor: 'duvida',
  marca: 'programa',
  comparacao: 'plano',
};

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  // Leitura relacionada: primeiro os do mesmo tema, depois os mais recentes de
  // outros temas, ate tres. Calculado aqui porque getStaticPaths roda separado
  // do corpo da pagina.
  const porData = [...posts].sort(
    (a, b) => b.data.publicado.valueOf() - a.data.publicado.valueOf()
  );

  return posts.map((post) => {
    const mesmoTema = porData.filter(
      (p) => p.id !== post.id && p.data.cluster === post.data.cluster
    );
    const outros = porData.filter(
      (p) => p.id !== post.id && p.data.cluster !== post.data.cluster
    );
    const relacionados = [...mesmoTema, ...outros].slice(0, 3);
    return { params: { slug: post.id }, props: { post, relacionados } };
  });
}

const { post, relacionados } = Astro.props;
const { Content } = await render(post);

const path = `/blog/${post.id}`;
const iso = (d) => d.toISOString().slice(0, 10);
const atualizadoEm = iso(post.data.atualizado ?? post.data.publicado);

const schemaArtigo = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: iso(post.data.publicado),
  dateModified: atualizadoEm,
  inLanguage: SITE.locale,
  author: { '@type': 'Person', name: AUTOR.nome, '@id': `${SITE.url}/#autor` },
  mainEntityOfPage: new URL(path, SITE.url).href,
};

// timeZone UTC e obrigatorio: a data do frontmatter vira meia-noite UTC, e sem
// isso o Brasil, tres horas atras, mostra o dia anterior.
const fmt = (d) =>
  d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Base
  title={post.data.title}
  description={post.data.description}
  {path}
  {atualizadoEm}
  schemaExtra={schemaArtigo}
>
  <article class="wrap stack--lg stack">

    <header class="stack">
      <h1>{post.data.title}</h1>
      <p class="answer">{post.data.resposta}</p>
      <p class="meta-line">
        Por {AUTOR.nome} · publicado em {fmt(post.data.publicado)}
        {post.data.atualizado && post.data.atualizado.valueOf() !== post.data.publicado.valueOf()
          && ` · atualizado em ${fmt(post.data.atualizado)}`}
      </p>
    </header>

    <div class="prosa">
      <Content />
    </div>

    {post.data.fontes.length > 0 && (
      <section class="card stack">
        <h2>Fontes</h2>
        <ul>
          {post.data.fontes.map((f) => (
            <li><a href={f.url} rel="nofollow noopener">{f.rotulo}</a></li>
          ))}
        </ul>
      </section>
    )}

    {/* A nota vem do layout, não do corpo do post: antes ela era colada à mão
        em cada arquivo, com redação diferente em cada um, e a afirmação sobre
        o chip repetida treze vezes pelo site. */}
    <NotaDeTransparencia fontes={atualizadoEm} />

    <p class="meta-line">
      Achou um erro? Escreva e eu corrijo, com nota de correção na página.
      Veja os <a href="/avisos-legais">avisos legais</a>.
    </p>

    {relacionados.length > 0 && (
      <section class="relacionados stack">
        <h2>Leia também</h2>
        {relacionados.map((p) => (
          <article class="card">
            <p class="eyebrow">{ROTULO_DO_CLUSTER[p.data.cluster] ?? 'Blog'}</p>
            <h3><a href={`/blog/${p.id}`}>{p.data.title}</a></h3>
            <p class="meta-line">{p.data.description}</p>
          </article>
        ))}
      </section>
    )}

    <ProximoPasso
      contexto={post.id === 'portabilidade-sem-perder-o-numero'
        ? 'portabilidade'
        : (CONTEXTO_POR_CLUSTER[post.data.cluster] ?? 'duvida')}
    />

  </article>
</Base>

<style>
  .prosa { display: flex; flex-direction: column; gap: 1.1rem; }
  .prosa :global(h2) { margin-top: 1.4rem; }
  .prosa :global(h3) { margin-top: 0.6rem; }
  .prosa :global(ul), .prosa :global(ol) { padding-left: 1.2rem; }

  /* Tabelas dentro do texto: a largura é do conteúdo, e número é dado. */
  .prosa :global(table) {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.93rem;
    display: block;
    overflow-x: auto;
  }
  .prosa :global(th), .prosa :global(td) {
    text-align: left;
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  .prosa :global(th) {
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--muted);
    background: var(--surface);
    white-space: nowrap;
  }
  .prosa :global(code) {
    font-family: var(--mono);
    font-size: 0.88em;
    background: var(--accent-soft);
    padding: 0.08em 0.32em;
    border-radius: 3px;
  }

  /* -----------------------------------------------------------------
     "O que eu não consegui confirmar"
     É a seção que mais distingue este site, e em Markdown era um ## igual
     aos outros. O plugin de build a marca; aqui ela ganha o tratamento de
     "em aberto": tracejado, porque nada ali está resolvido.
     ----------------------------------------------------------------- */
  .prosa :global(.secao-aberta__titulo) {
    margin-top: 2.2rem;
    padding-top: 1.4rem;
    border-top: 1px dashed var(--rule);
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .prosa :global(.secao-aberta__titulo)::before {
    content: "";
    width: 9px;
    height: 9px;
    flex: none;
    border: 1px dashed var(--muted);
    border-radius: 50%;
    transform: translateY(-0.15em);
  }
  .prosa :global(.secao-aberta) {
    border-left: 1px dashed var(--rule);
    padding-left: 1.1rem;
    margin-left: 0.1rem;
    color: var(--muted);
  }
  .prosa :global(.secao-aberta strong) { color: var(--ink); }
</style>
