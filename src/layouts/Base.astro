---
import '../styles/global.css';
import { SITE, AUTOR, VINCULO, EMPRESA } from '../data/site.js';
import { urlDoCartao } from '../data/og.js';
import { NAV } from '../data/paginas.js';
import { CLOUDFLARE_TOKEN, MEDINDO } from '../data/medicao.js';
import { linkWhatsApp } from '../data/contato.js';
import { Image } from 'astro:assets';
import FaixaDeConferencia from '../components/FaixaDeConferencia.astro';
import logoClaro from '../assets/logo-movva-preta-verde.png';
import logoEscuro from '../assets/logo-movva-branca-verde.png';

const {
  title,
  description,
  path = '/',
  atualizadoEm,
  tipo = 'article',
  schemaExtra = null,
  naoIndexar = false,
  // A home é página de vendas e vai escura para todo mundo, não só para quem
  // tem o sistema no escuro. As outras páginas seguem a preferência de quem lê.
  tema = null,
} = Astro.props;

const canonical = new URL(path, SITE.url).href;
const ogImagem = await urlDoCartao(path);
const tituloCompleto = path === '/' ? title : `${title} — ${SITE.name}`;

const schemaBase = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#site`,
      url: SITE.url,
      name: SITE.name,
      description: VINCULO,
      inLanguage: SITE.locale,
      publisher: { '@id': `${SITE.url}/#autor` },
    },
    {
      '@type': 'Person',
      '@id': `${SITE.url}/#autor`,
      name: AUTOR.nome,
      jobTitle: AUTOR.papel,
      url: SITE.url,
      sameAs: AUTOR.perfis,
    },
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#movva`,
      name: EMPRESA.razaoSocial,
      alternateName: 'MOVVA',
      taxID: EMPRESA.cnpj,
      // O endereco oficial da empresa e outro dominio. Sem url e sameAs, o
      // grafo deixava um Organization com CNPJ e endereco identificado por um
      // @id neste host — que e exatamente o conjunto de propriedades que um
      // buscador usa para concluir que o site e da propria empresa.
      url: 'https://movvabrasil.com',
      sameAs: ['https://movvabrasil.com'],
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Avenida Paulista, 1842, Conjunto 178',
        addressLocality: 'São Paulo',
        addressRegion: 'SP',
        postalCode: '01310-923',
        addressCountry: 'BR',
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#pagina`,
      url: canonical,
      name: title,
      description,
      inLanguage: SITE.locale,
      isPartOf: { '@id': `${SITE.url}/#site` },
      author: { '@id': `${SITE.url}/#autor` },
      // "about" e o que fecha a leitura do grafo: diz que esta pagina FALA
      // SOBRE a MOVVA, enquanto author e publisher continuam na Person.
      about: { '@id': `${SITE.url}/#movva` },
      image: ogImagem,
      ...(atualizadoEm ? { dateModified: atualizadoEm } : {}),
    },
  ],
};

// concat achata: uma página pode passar um schema só ou vários. Antes isto
// aceitava só um objeto, e uma página com dois schemas publicava o segundo
// aninhado dentro do primeiro — JSON-LD válido na sintaxe e invisível na
// leitura.
const schemas = schemaExtra ? [schemaBase, ...[].concat(schemaExtra)] : [schemaBase];

// O menu vem de src/data/paginas.js, com a lista que o llms.txt também lê.
// Escrito aqui, ele e o llms.txt discordavam a cada página nova.
const nav = NAV.map((p) => ({ href: p.path, rotulo: p.rotulo }));

const dataLegivel = atualizadoEm
  ? new Date(`${atualizadoEm}T12:00:00`).toLocaleDateString('pt-BR', {
      day: '2-digit', month: 'long', year: 'numeric',
    })
  : null;
---
<!doctype html>
<html lang="pt-BR" class={tema === 'escuro' ? 'raiz-escura' : undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

  <title>{tituloCompleto}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {naoIndexar && <meta name="robots" content="noindex, nofollow" />}

  <meta property="og:type" content={tipo} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:title" content={tituloCompleto} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImagem} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`Imagem de compartilhamento: ${title}`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImagem} />
  <meta name="twitter:title" content={tituloCompleto} />
  <meta name="twitter:description" content={description} />

  <meta name="author" content={AUTOR.nome} />
  {atualizadoEm && <meta name="last-modified" content={atualizadoEm} />}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- IBM Plex: família desenhada para uma empresa de tecnologia, com Sans e
       Mono que foram feitos juntos. O Mono não é enfeite aqui: ele marca
       identificador real — CNPJ, número de ato, processo, código de rede. -->
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
  />

  {schemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}

  {/* Medicao sem cookie. Nao carrega nada enquanto o token estiver vazio. */}
  {MEDINDO && (
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={JSON.stringify({ token: CLOUDFLARE_TOKEN })}
    />
  )}
</head>
<body class={tema === 'escuro' ? 'escuro' : undefined}>

  <a class="pular" href="#conteudo">Pular para o conteúdo</a>

  <header class="cabecalho">
    <div class="wrap wrap--wide cabecalho__linha">
      <!-- O logotipo é da MOVVA; o ".net" ao lado é o que diz de quem é o site.
           Os dois juntos são a marca do cabeçalho: a empresa que eu represento,
           e o endereço que é meu. As duas versões ficam no HTML e o CSS escolhe
           pelo tema — alt vazio nas duas, senão o leitor de tela lê duas vezes. -->
      <a href="/" class="marca" aria-label="Movva Brasil .net — início">
        <Image src={logoClaro} alt="" width={200} densities={[1, 2]} class="marca__logo marca__logo--claro" />
        <Image src={logoEscuro} alt="" width={200} densities={[1, 2]} class="marca__logo marca__logo--escuro" />
        <span class="marca__tld" aria-hidden="true">.net</span>
      </a>
      <nav aria-label="Principal">
        <ul class="nav" role="list">
          {nav.map((i) => (
            <li><a href={i.href} aria-current={i.href === path ? 'page' : undefined}>{i.rotulo}</a></li>
          ))}
        </ul>
      </nav>
      <a
        class="btn btn--sm cabecalho__cta"
        href={linkWhatsApp('plano')}
        rel="nofollow sponsored noopener"
        target="_blank"
      >Contratar</a>
    </div>
  </header>

  {/* Logo abaixo do cabeçalho, antes de qualquer conteúdo: é a credencial que
      enquadra tudo o que vem depois. Fina, para não disputar a primeira tela
      com a oferta. */}
  <FaixaDeConferencia />

  <main id="conteudo" tabindex="-1">
    <slot />
  </main>

  <footer class="rodape">
    <div class="wrap wrap--wide stack">
      <p class="meta-line">{VINCULO}</p>
      <!-- A relação já está na linha acima; esta declara o INCENTIVO, que é
           outra coisa e é o que o CDC art. 36 e o CONAR pedem junto da oferta.
           A home repete a frase no alto, perto dos botões. -->
      <p class="meta-line">
        Recebo comissão se você contratar um plano ou se cadastrar pelos links
        daqui. <a href="/avisos-legais">Como eu ganho</a>.
      </p>
      <p class="meta-line">
        Publicado por <a href="/sobre">{AUTOR.nome}</a>, {AUTOR.papel}. As informações sobre a empresa citadas
        aqui vêm de registros públicos e podem ser conferidas de forma independente na
        <a href={EMPRESA.fontes.receita} rel="nofollow noopener">Receita Federal</a> e no
        <a href={EMPRESA.fontes.anatel} rel="nofollow noopener">sistema da Anatel</a>.
      </p>
      <p class="meta-line">
        Participar do programa de afiliados não garante ganho de nenhum valor. Os
        resultados variam conforme o esforço de cada pessoa, e a maioria dos
        participantes de programas desse tipo não obtém renda significativa.
        Veja os <a href="/avisos-legais">avisos legais</a> com os números reais.
      </p>
      {dataLegivel && <p class="meta-line">Página atualizada em {dataLegivel}.</p>}
      <ul class="nav nav--rodape" role="list">
        <li><a href="/sobre">Quem escreve</a></li>
        <li><a href="/avisos-legais">Avisos legais</a></li>
        <li><a href="/politica-de-privacidade">Política de privacidade</a></li>
        <li><a href="/termos-de-uso">Termos de uso</a></li>
      </ul>
    </div>
  </footer>

</body>
</html>

<style>
  /* Primeira parada do teclado. Sem ela, seis elementos do cabeçalho — a
     marca, os quatro itens de menu e o botão — ficavam entre a pessoa e o
     texto, em toda página. Fora da tela por padrão, volta ao receber foco. */
  .pular {
    position: absolute;
    left: 0.5rem;
    top: -4rem;
    z-index: 30;
    padding: 0.55rem 0.9rem;
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: 6px;
    text-decoration: none;
    transition: top 120ms ease-out;
  }
  .pular:focus, .pular:focus-visible { top: 0.5rem; }
  /* O <main> recebe foco programático pelo salto; sem isto o navegador
     desenharia o anel em volta da página inteira. */
  main:focus { outline: none; }

  /* Fica no topo enquanto a pessoa rola: numa página de vendas o botão de
     assinar não pode depender de ela voltar lá em cima para encontrá-lo. */
  .cabecalho {
    position: sticky;
    top: 0;
    z-index: 20;
    padding-block: 0.85rem;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }
  /* Onde o navegador aceita, o fundo fica translúcido e desfoca o conteúdo
     que passa por baixo — é o que faz a barra parecer vidro e não um bloco. */
  @supports (backdrop-filter: blur(1px)) {
    .cabecalho {
      background: color-mix(in srgb, var(--paper) 78%, transparent);
      backdrop-filter: saturate(1.6) blur(14px);
    }
  }
  /* O fio verde embaixo da barra: a única linha colorida do cabeçalho. Era
     degradê; virou cor chapada porque um degradê de 1px não se lê como
     degradê — só soma mais um gradiente à página. */
  .cabecalho::after {
    content: "";
    position: absolute;
    inset: auto 0 -1px;
    height: 1px;
    background: var(--accent);
    opacity: 0.5;
  }
  .cabecalho__linha {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.5rem;
  }
  .marca {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--ink);
    line-height: 1.1;
    margin-right: auto;
  }
  .marca__logo { height: 26px; width: auto; display: block; }
  /* O ".net" é pequeno e em mono: lê como o fim de um endereço, que é o que
     é — e é o que separa este site do movvabrasil.com, o oficial.
     É o único texto da interface que usa o verde do LOGOTIPO, e só onde ele
     passa em contraste: colado no logotipo, uma tonalidade diferente se nota.
     No tema claro o #00D500 daria 2:1 sobre branco, então ali vale o verde de
     interface — longe o bastante do logotipo preto para ninguém comparar. */
  .marca__tld {
    font-family: var(--mono);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: -0.01em;
  }

  /* Logotipo preto no tema claro, branco no escuro. Na home, que leva
     body.escuro, é sempre o branco: ali o escuro é decisão de direção e não
     depende da preferência de quem lê. */
  body.escuro .marca__tld { color: var(--marca); }

  .marca__logo--escuro { display: none; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .marca__logo--claro { display: none; }
    :root:not([data-theme="light"]) .marca__logo--escuro { display: block; }
    :root:not([data-theme="light"]) .marca__tld { color: var(--marca); }
  }
  :root[data-theme="dark"] .marca__logo--claro { display: none; }
  :root[data-theme="dark"] .marca__logo--escuro { display: block; }
  body.escuro .marca__logo--claro { display: none; }
  body.escuro .marca__logo--escuro { display: block; }

  /* flex-direction: row é obrigatório aqui. O global.css transforma todo ul do
     site em coluna, para o espaçamento de listas de texto, e o menu herdava
     isso — ficava uma linha por item, em toda largura de tela. */
  .nav {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.94rem;
  }
  .nav a { color: var(--muted); text-decoration: none; }
  .nav a:hover, .nav a[aria-current="page"] { color: var(--accent); }

  /* No celular o menu ao lado da marca empilhava em coluna e o cabeçalho
     comia 156px — 27% da primeira tela antes do título aparecer. Empilhando
     marca e menu, o menu volta a ser uma linha e o cabeçalho cai pela metade. */
  /* No celular a marca e o botão dividem a primeira linha e o menu desce
     inteiro para a segunda. Sem o width: 100% o <nav> encolhe até o item
     mais largo e a lista quebra uma linha por item — foi o que já fez este
     cabeçalho comer 27% da primeira tela. */
  @media (max-width: 40rem) {
    .cabecalho { padding-block: 0.65rem; }
    .cabecalho__linha { gap: 0.5rem 0.9rem; }
    .cabecalho__linha > nav { order: 3; width: 100%; }
    .nav { gap: 0.25rem 1.05rem; font-size: 0.86rem; }
    .marca__logo { height: 22px; }
    .btn--sm { padding: 0.45rem 0.85rem; font-size: 0.85rem; }
  }

  .rodape {
    margin-top: 4rem;
    border-top: 1px solid var(--rule);
    padding-block: 2.5rem 3.5rem;
    background: var(--surface);
  }
  .nav--rodape { padding-top: 0.25rem; }
</style>
