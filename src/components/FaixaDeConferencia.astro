---
// A faixa de conferência, no alto de toda página.
//
// Ela não afirma que o site é cuidadoso, mostra a conta: quantas fontes
// primárias o conteúdo cita e quantos pontos continuam sem confirmação.
//
// Os dois números falam da MOVVA, não do autor. Houve um terceiro, "correções
// assumidas", e ele saiu: incerteza sobre o assunto constrói confiança, erro
// do autor a destrói — o leitor não conclui "é rigoroso", conclui "erra".
//
// Nenhum número aqui é escrito à mão — ver src/data/conferencia.js.
import { conferencia } from '../data/conferencia.js';

const { fontes, emAberto, conferidoEm } = await conferencia();

// Data curta: por extenso ela empurrava a faixa para duas linhas, e faixa de
// duas linhas deixa de ser faixa.
const dia = conferidoEm.toLocaleDateString('pt-BR', { timeZone: 'UTC' });
---

<div class="faixa">
  <div class="wrap wrap--wide faixa__linha">
    <span class="faixa__item faixa__item--data">Conferido em {dia}</span>
    <span class="faixa__sep" aria-hidden="true">·</span>
    <span class="faixa__item"><strong>{fontes}</strong> fontes primárias</span>
    <span class="faixa__sep" aria-hidden="true">·</span>
    <span class="faixa__item"><strong>{emAberto}</strong> pontos em aberto</span>
  </div>
</div>

<style>
  /* Fina de propósito: ela é credencial, não chamada. Compete com o cabeçalho
     se crescer, e a primeira tela pertence à oferta. */
  .faixa {
    background: var(--veu-1);
    border-bottom: 1px solid var(--rule);
    padding-block: 0.4rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
  }
  .faixa__linha {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.55rem;
  }
  .faixa__item { white-space: nowrap; }
  .faixa__item strong { color: var(--accent); font-weight: 600; }
  /* --muted, e nao --rule. A cor de borda e escura demais para virar texto:
     medido, o ponto ficava em 1,21 de contraste no tema escuro (#18222C sobre
     #000408) e em pouco mais que isso no claro (#DCE5DF sobre #F6F9F7) — ou
     seja, invisivel nos dois. Sem ele, os dois numeros da faixa se encostam e
     leem como um so. O ponto e aria-hidden, entao nao precisa dos 4,5 de
     texto; precisa aparecer. */
  .faixa__sep { color: var(--muted); opacity: 0.55; }
  .faixa__item--link { color: var(--muted); text-decoration: none; border-bottom: 1px dotted var(--rule); }
  .faixa__item--link:hover { color: var(--accent); border-bottom-color: var(--accent); }

  /* No celular a data sai: ela é a parte menos acionável, e sem ela os três
     números cabem numa linha só. A data continua no rodapé de toda página. */
  @media (max-width: 40rem) {
    .faixa__item--data,
    .faixa__item--data + .faixa__sep { display: none; }
    .faixa { font-size: 0.68rem; }
  }
</style>
